id": 12779, "profile_image": "https://thespacedevs-prod.nyc3.digitaloceanspaces.com/media/profile_images/cosmic2520penguin_profile_20210817212020.png", "comment": "NET 2H 2026.", "info_url": "https://www.ses.com/sites/default/files/2025-11/SES%20Delivers%20Solid%209%20Months%20and%20Q3%202025%20Results.pdf", "created_by": "Cosmic_Penguin", "created_on": "2025-11-06T07:48:00Z"}, {"id": 11472, "profile_image": "https://thespacedevs-prod.nyc3.digitaloceanspaces.com/media/profile_images/cosmic2520penguin_profile_20210817212020.png", "comment": "NET 2026, with 3 satellites on board.", "info_url": "https://spacenews.com/boeing-ships-more-o3b-mpower-satellites-with-fixes-ses-might-not-need/", "created_by": "Cosmic_Penguin", "created_on": "2025-07-03T01:22:00Z"}, {"id": 10192, "profile_image": "https://thespacedevs-prod.nyc3.digitaloceanspaces.com/media/profile_images/cosmic2520penguin_profile_20210817212020.png", "comment": "NET late 2026.", "info_url": "https://www.ses.com/sites/default/files/2025-02/2502_FY-2024-Results_Analyst-Presentation_FINAL.pdf", "created_by": "Cosmic_Penguin", "created_on": "2025-02-26T07:54:00Z"}, {"id": 9577, "profile_image": "https://thespacedevs-prod.nyc3.digitaloceanspaces.com/media/profile_images/cosmic2520penguin_profile_20210817212020.png", "comment": "Added launch for around Q2 2026.", "info_url": "https://spacenews.com/spacex-launches-redesigned-o3b-mpower-satellites/", "created_by": "Cosmic_Penguin", "created_on": "2024-12-18T19:18:00Z"}], "info_urls": [{"priority": 10, "source": "spacex.com", "title": "SpaceX", "description": "SpaceX designs, manufactures and launches advanced rockets and spacecraft. The company was founded in 2002 to revolutionize space technology, with the ultimate goal of enabling people to live on other planets.", "feature_image": null, "url": "https://www.spacex.com/launches/mpower-f", "type": {"id": 1, "name": "Official Page"}, "language": {"id": 1, "name": "English", "code": "en"}}], "vid_urls": [{"priority": 7, "source": "youtube.com", "publisher": "The Space Devs", "title": "SpaceX O3b mPower 11-13", "description": "On Sunday September 13, 2026 at 18:49 UTC, SpaceX launched the O3b mPower 11-13 mission with a Falcon 9 Block 5 from Space Launch Complex 40 at Cape Canaveral SFS, FL, USA.\n\nDescription generated from the Launch Library 2 API.\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\nObject in the Launch Library 2 API: https://ll.thespacedevs.com/2.3.0/launches/ad358a4d-c541-409b-9366-9c2f2da4aeb9/?format=json\nRelated news in the Spaceflight News API: https://api.spaceflightnewsapi.net/v4/articles/?launch=ad358a4d-c541-409b-9366-9c2f2da4aeb9\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\nRehosted on YouTube by The Space Devs.\nSupport our work on https://www.patreon.com/TheSpaceDevs\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\nWebsite: https://thespacedevs.com\nX: https://x.com/thespacedevs\nDiscord: https://discord.com/invite/p7ntkNA\n\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\u2014\n\nOrigina...", "feature_image": "https://i.ytimg.com/vi/zZHnf8QB5ok/maxresdefault.jpg", "url": "https://www.youtube.com/watch?v=zZHnf8QB5ok", "type": {"id": 4, "name": "Unofficial Re-stream"}, "language": {"id": 1, "name": "English", "code": "en"}, "start_time": "2026-09-13T19:47:20Z", "end_time": "2026-09-13T20:49:12Z", "live": false}, {"priority": 8, "source": "youtube.com", "publisher": "Spaceflight Now", "title": "Live: SpaceX Falcon 9 rocket launches three O3b mPOWER satellites from Cape Canaveral", "description": "Watch live coverage as SpaceX launches a Falcon 9 rocket carrying three O3b mPOWER communications satellites for Luxembourg-based SES. Liftoff  from Space Launch Complex 40 at Cape Canaveral Space Force Station is scheduled for Sunday, September 13, during a launch window that opens at 2:49 p.m. EDT (1849 UTC).\n\nThe first-stage Falcon 9 booster, serial number B1080, launching for a 29th time, will take an easterly trajectory on departure from Florida's Space Coast. About 8.5 minutes into flight it will land on SpaceX's drone ship 'A Shortfall of Gravitas', stationed in the Atlantic Ocean.\n\nOur live coverage with commentary from Spaceflight Now's Will Robinson-Smith will start about one hour prior to launch.\n\nVideos like this are made possible by the support of our members. Join this c...", "feature_image": "https://i.ytimg.com/vi/r0avdYfJO2Q/maxresdefault.jpg", "url": "https://www.youtube.com/watch?v=r0avdYfJO2Q", "type": {"id": 3, "name": "Unofficial Webcast"}, "language": {"id": 1, "name": "English", "code": "en"}, "start_time": "2026-09-13T17:48:49Z", "end_time": "2026-09-13T19:43:05Z", "live": false}, {"priority": 9, "source": "youtube.com", "publisher": "NASASpaceflight", "title": "SpaceX Launches Falcon 9 with O3b mPOWER 11, 12 & 13", "description": "Launch Window: September 13th from 14:49 to 16:16 EDT (18:49-20:16 UTC)\nCurrent T0: September 13th at 14:49 EDT (18:49 UTC)\n\nMission: Falcon 9 launch of three O3b mPOWER satellites for SES\nLaunch location: Space Launch Complex 40 (SLC-40), Cape Canaveral Space Force Station, Earth.\nTarget orbit: Medium Transfer Orbit \nBooster: B1080-29; 61d 9h 38min 48s turnaround\nPast customer missions: Axiom-2, Euclid, Axiom-3, CRS-30, SES-24, NG-21.\nPast Starlink missions: 6-11, 6-24, 6-52, 6-62, 10-10, 6-69, 12-1, 12-2, 12-4, 10-12, 6-80, 6-75, 10-32, 10-16, 10-30, 10-15, 6-78, 6-100, 10-40, 10-24, 10-54, 10-45.\nSatellites launched: 579, will be 582 after this mission.\nBooster recovery: A Shortfall Of Gravitas (ASOG)\nFairing recovery: Bob\nRocket trajectory: Straight east\nPayload mass: Approximatel...", "feature_image": "https://i.ytimg.com/vi/FgKKtSsyYD4/maxresdefault.jpg", "url": "https://www.youtube.com/watch?v=FgKKtSsyYD4", "type": {"id": 3, "name": "Unofficial Webcast"}, "language": {"id": 1, "name": "English", "code": "en"}, "start_time": "2026-09-13T17:50:08Z", "end_time": "2026-09-13T19:44:43Z", "live": false}, {"priority": 10, "source": "x.com", "publisher": "SpaceX", "title": "O3b mPOWER Mission", "description": "Livestream on X", "feature_image": "https://pbs.twimg.com/media/HRyLZuxWEAEyyLa.jpg", "url": "https://x.com/i/broadcasts/1RKjpbVdykQJw", "type": {"id": 1, "name": "Official Webcast"}, "language": {"id": 1, "name": "English", "code": "en"}, "start_time": "2026-09-13T18:36:07Z", "end_time": "2026-09-13T19:37:59Z", "live": false}], "timeline": [{"type": {"id": 1, "abbrev": "GO for Prop Load", "description": "Launch director verifies go for propellant load"}, "relative_time": "-PT38M"}, {"type": {"id": 2, "abbrev": "Prop Load", "description": "Start of propelland loading"}, "relative_time": "-PT35M"}, {"type": {"id": 3, "abbrev": "Stage 1 LOX Load", "description": "Start of liquid oxygen loading in the first stage"}, "relative_time": "-PT35M"}, {"type": {"id": 4, "abbrev": "Stage 2 LOX Load", "description": "Start of liquid oxygen loading in the second stage"}, "relative_time": "-PT16M"}, {"type": {"id": 5, "abbrev": "Engine Chill", "description": "Start of engine chilling"}, "relative_time": "-PT7M"}, {"type": {"id": 7, "abbrev": "Tank Press", "description": "Fuel tanks are pressurized to flight levels"}, "relative_time": "-PT1M"}, {"type": {"id": 6, "abbrev": "Startup", "description": "The onboard computer takes control over the countdown and runs last checks"}, "relative_time": "-PT1M"}, {"type": {"id": 8, "abbrev": "GO for Launch", "description": "Launch director verifies go for launch"}, "relative_time": "-PT45S"}, {"type": {"id": 9, "abbrev": "Ignition", "description": "Start of the engine ignition sequence"}, "relative_time": "-PT3S"}, {"type": {"id": 10, "abbrev": "Li